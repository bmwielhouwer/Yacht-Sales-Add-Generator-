{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/verify-code.js": { "maxDuration": 10 },
    "api/extract-boat-data.js": { "maxDuration": 30 },
    "api/analyze-photos.js": { "maxDuration": 60 },
    "api/generate-listing.js": { "maxDuration": 60 },
    "api/save-listing.js": { "maxDuration": 10 },
    "api/inquiry.js": { "maxDuration": 15 },
    "api/l/[slug].js": { "maxDuration": 10 },
    "api/stripe/webhook.js": { "maxDuration": 15 },
    "api/dashboard/[action].js": { "maxDuration": 15 },
    "api/outreach/[action].js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/l/:slug", "destination": "/api/l/:slug" }
  ]
}
